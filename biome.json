{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/generated",
      "!**/*.sql",
      "!**/*.md",
      "!**/worker-configuration.d.ts",
      "!packages/admin/src/components/ui",
      "!**/*.css"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/admin/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConfusingVoidType": "off"
          },
          "a11y": {
            "noLabelWithoutControl": {
              "level": "error",
              "options": {
                "inputComponents": ["Switch", "Checkbox", "Input", "Textarea", "MoneyInput"]
              }
            }
          }
        }
      }
    }
  ]
}
