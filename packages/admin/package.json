{
  "name": "@talajs/admin",
  "version": "0.1.1",
  "description": "Tala's admin web app: a static React build, configured at runtime.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/NovaDovaDao/talajs/tree/main/packages/admin#readme",
  "bugs": {
    "url": "https://github.com/NovaDovaDao/talajs/issues"
  },
  "keywords": [
    "react",
    "shadcn",
    "admin",
    "pos",
    "cloudflare-workers"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaDovaDao/talajs.git",
    "directory": "packages/admin"
  },
  "files": [
    "dist",
    "!dist/tala-admin.json",
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.serve.json",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.serve.json",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@talajs/contracts": "workspace:*",
    "@tanstack/react-query": "~5.107.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "oauth4webapi": "^3.8.8",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vite": "^8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "dependencies": {},
  "exports": {
    ".": {
      "@talajs/source": "./serve/index.ts",
      "types": "./server/index.d.ts",
      "default": "./server/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./server/index.d.ts",
        "default": "./server/index.js"
      },
      "./dist/*": "./dist/*",
      "./package.json": "./package.json"
    }
  }
}
