// Tala commerce core schema. Everything lives in the Postgres schema "tala".
//
// Conventions
// - Every tenant-owned table has `tenant_id` and a `UNIQUE (tenant_id, id)` key; all relations
//   between tenant-owned rows are composite `(tenant_id, x_id) -> (tenant_id, id)`, so the
//   database itself rejects cross-tenant references.
// - Rows are archived (`archived_at`) rather than deleted; relations use RESTRICT, never SET NULL
//   (SET NULL on a composite key would also null `tenant_id`).
// - Money is integer minor units plus an ISO 4217 `currency`.
// - Ids are UUIDs (v7, generated by the app or by offline terminals).
//
// Migrations are generated from this file into ../migrations/*.sql (see README) and applied by
// `tala-db migrate`, which records history in tala._migrations.

generator node {
  provider               = "prisma-client"
  output                 = "../src/generated/node"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

generator workerd {
  provider               = "prisma-client"
  output                 = "../src/generated/workerd"
  runtime                = "workerd"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["tala"]
}

// ───────────────────────────── tenancy & access ─────────────────────────────

model Tenant {
  id              String    @id @db.Uuid
  name            String
  slug            String    @unique
  defaultCurrency String    @map("default_currency") @db.Char(3)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  stores          Store[]
  memberships     Membership[]
  terminals       Terminal[]
  taxRates        TaxRate[]
  categories      Category[]
  items           Item[]
  modifierGroups  ModifierGroup[]
  stockLevels     StockLevel[]
  customers       Customer[]
  tags            Tag[]
  orders          Order[]
  paymentAccounts PaymentAccount[]
  syncMutations   SyncMutation[]
  reviewItems     ReviewItem[]
  domainEvents    DomainEvent[]

  @@map("tenant")
  @@schema("tala")
}

model Store {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  slug             String
  currency         String    @db.Char(3)
  timezone         String    @default("UTC")
  pricesIncludeTax Boolean   @default(false) @map("prices_include_tax")
  /// Next server-assigned order number for this store.
  nextOrderNumber  Int       @default(1) @map("next_order_number")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  terminals   Terminal[]
  storeItems  StoreItem[]
  stockLevels StockLevel[]
  orders      Order[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@map("store")
  @@schema("tala")
}

enum MemberRole {
  OWNER
  MANAGER
  STAFF

  @@map("member_role")
  @@schema("tala")
}

model Membership {
  id        String     @id @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  /// Identity-provider subject (or verified email for Cloudflare Access).
  subject   String
  role      MemberRole
  /// Empty = all stores.
  storeIds  String[]   @default([]) @map("store_ids") @db.Uuid
  revokedAt DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, subject])
  @@index([subject])
  @@map("membership")
  @@schema("tala")
}

model Terminal {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  name             String
  /// Short code used in offline order numbers, e.g. "T2" -> "T2-0042".
  code             String
  /// sha256 of the bearer token; the token itself is never stored.
  tokenHash        String?   @unique @map("token_hash")
  pairingCodeHash  String?   @unique @map("pairing_code_hash")
  pairingExpiresAt DateTime? @map("pairing_expires_at") @db.Timestamptz(3)
  scopes           String[]  @default([])
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store         Store          @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  orders        Order[]
  payments      Payment[]
  syncMutations SyncMutation[]

  @@unique([tenantId, id])
  @@unique([tenantId, storeId, code])
  @@map("terminal")
  @@schema("tala")
}

// ───────────────────────────────── catalog ──────────────────────────────────

model TaxRate {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  /// Basis points: 825 = 8.25%.
  rateBps    Int       @map("rate_bps")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items  Item[]

  @@unique([tenantId, id])
  @@map("tax_rate")
  @@schema("tala")
}

model Category {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  name       String
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   Category?      @relation("CategoryTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children Category[]     @relation("CategoryTree")
  items    ItemCategory[]

  @@unique([tenantId, id])
  @@map("category")
  @@schema("tala")
}

model Item {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  description String?
  taxRateId   String?   @map("tax_rate_id") @db.Uuid
  version     Int       @default(1)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  taxRate        TaxRate?            @relation(fields: [tenantId, taxRateId], references: [tenantId, id], onDelete: Restrict)
  categories     ItemCategory[]
  variants       Variant[]
  modifierGroups ItemModifierGroup[]
  storeItems     StoreItem[]

  @@unique([tenantId, id])
  @@map("item")
  @@schema("tala")
}

model ItemCategory {
  tenantId   String @map("tenant_id") @db.Uuid
  itemId     String @map("item_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  sortOrder  Int    @default(0) @map("sort_order")

  item     Item     @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)
  category Category @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, itemId, categoryId])
  @@index([tenantId, categoryId])
  @@map("item_category")
  @@schema("tala")
}

model Variant {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  /// e.g. "12oz". Single-variant items use the item name or "Regular".
  name         String
  sku          String?
  priceMinor   Int       @map("price_minor")
  currency     String    @db.Char(3)
  stockLevelId String?   @map("stock_level_id") @db.Uuid
  sortOrder    Int       @default(0) @map("sort_order")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  item       Item        @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  stockLevel StockLevel? @relation(fields: [tenantId, stockLevelId], references: [tenantId, id], onDelete: Restrict)
  orderLines OrderLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, itemId])
  @@map("variant")
  @@schema("tala")
}

model ModifierGroup {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  /// e.g. "Milk", "Extra shots".
  name       String
  minSelect  Int       @default(0) @map("min_select")
  maxSelect  Int       @default(1) @map("max_select")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  modifiers Modifier[]
  items     ItemModifierGroup[]

  @@unique([tenantId, id])
  @@map("modifier_group")
  @@schema("tala")
}

model Modifier {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  groupId         String    @map("group_id") @db.Uuid
  /// e.g. "Oat".
  name            String
  priceDeltaMinor Int       @default(0) @map("price_delta_minor")
  stockLevelId    String?   @map("stock_level_id") @db.Uuid
  sortOrder       Int       @default(0) @map("sort_order")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  group         ModifierGroup       @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Restrict)
  stockLevel    StockLevel?         @relation(fields: [tenantId, stockLevelId], references: [tenantId, id], onDelete: Restrict)
  lineModifiers OrderLineModifier[]

  @@unique([tenantId, id])
  @@index([tenantId, groupId])
  @@map("modifier")
  @@schema("tala")
}

model ItemModifierGroup {
  tenantId  String @map("tenant_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  item  Item          @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)
  group ModifierGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, itemId, groupId])
  @@map("item_modifier_group")
  @@schema("tala")
}

/// Per-store availability and optional price override.
model StoreItem {
  tenantId           String  @map("tenant_id") @db.Uuid
  storeId            String  @map("store_id") @db.Uuid
  itemId             String  @map("item_id") @db.Uuid
  available          Boolean @default(true)
  priceOverrideMinor Int?    @map("price_override_minor")

  store Store @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Cascade)
  item  Item  @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, storeId, itemId])
  @@map("store_item")
  @@schema("tala")
}

// ──────────────────────────────── inventory ─────────────────────────────────

model StockLevel {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  name          String
  unit          String   @default("each")
  onHand        Int      @default(0) @map("on_hand")
  /// When true, online/admin orders are refused instead of driving stock negative.
  /// Offline terminal sales are always accepted (see docs/PLAN.md §2.4).
  trackStrictly Boolean  @default(true) @map("track_strictly")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store     Store           @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  variants  Variant[]
  modifiers Modifier[]
  movements StockMovement[]

  @@unique([tenantId, id])
  @@index([tenantId, storeId])
  @@map("stock_level")
  @@schema("tala")
}

enum StockMovementReason {
  SALE
  VOID
  REFUND
  ADJUST
  RECOUNT
  RECEIVE

  @@map("stock_movement_reason")
  @@schema("tala")
}

model StockMovement {
  id             String              @id @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  stockLevelId   String              @map("stock_level_id") @db.Uuid
  delta          Int
  reason         StockMovementReason
  orderLineId    String?             @map("order_line_id") @db.Uuid
  syncMutationId String?             @map("sync_mutation_id") @db.Uuid
  note           String?
  actor          String
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  stockLevel StockLevel @relation(fields: [tenantId, stockLevelId], references: [tenantId, id], onDelete: Restrict)
  orderLine  OrderLine? @relation(fields: [tenantId, orderLineId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, stockLevelId, createdAt])
  @@map("stock_movement")
  @@schema("tala")
}

// ──────────────────────────────── customers ─────────────────────────────────

model Customer {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  name           String?
  /// Stored lower-cased.
  email          String?
  phone          String?
  marketingOptIn Boolean   @default(false) @map("marketing_opt_in")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notes  CustomerNote[]
  tags   CustomerTag[]
  orders Order[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@map("customer")
  @@schema("tala")
}

model CustomerNote {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  body       String
  author     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, customerId, createdAt])
  @@map("customer_note")
  @@schema("tala")
}

model Tag {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customers CustomerTag[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("tag")
  @@schema("tala")
}

model CustomerTag {
  tenantId   String @map("tenant_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, customerId, tagId])
  @@index([tenantId, tagId])
  @@map("customer_tag")
  @@schema("tala")
}

// ────────────────────────────── orders & tabs ───────────────────────────────

enum OrderStatus {
  /// Tab or cart being built.
  OPEN
  COMPLETED
  VOIDED

  @@map("order_status")
  @@schema("tala")
}

enum OrderSource {
  POS
  ONLINE
  ADMIN

  @@map("order_source")
  @@schema("tala")
}

model Order {
  /// Client-generated UUID; doubles as the idempotency key.
  id            String      @id @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  storeId       String      @map("store_id") @db.Uuid
  terminalId    String?     @map("terminal_id") @db.Uuid
  customerId    String?     @map("customer_id") @db.Uuid
  /// Display number: per-store counter ("42") or terminal-prefixed offline ("T2-0042").
  number        String
  status        OrderStatus @default(OPEN)
  source        OrderSource
  isTab         Boolean     @default(false) @map("is_tab")
  tabName       String?     @map("tab_name")
  note          String?
  currency      String      @db.Char(3)
  subtotalMinor Int         @default(0) @map("subtotal_minor")
  discountMinor Int         @default(0) @map("discount_minor")
  taxMinor      Int         @default(0) @map("tax_minor")
  totalMinor    Int         @default(0) @map("total_minor")
  tipMinor      Int         @default(0) @map("tip_minor")
  /// Optimistic-concurrency version; bumped on every change (tabs edited from several terminals).
  version       Int         @default(1)
  openedAt      DateTime    @default(now()) @map("opened_at") @db.Timestamptz(3)
  /// Actor (member subject, service or terminal) who opened, completed or voided the order.
  openedBy      String      @map("opened_by")
  completedAt   DateTime?   @map("completed_at") @db.Timestamptz(3)
  completedBy   String?     @map("completed_by")
  voidedAt      DateTime?   @map("voided_at") @db.Timestamptz(3)
  voidedBy      String?     @map("voided_by")
  voidReason    String?     @map("void_reason")
  receiptSentAt DateTime?   @map("receipt_sent_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store    Store       @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  terminal Terminal?   @relation(fields: [tenantId, terminalId], references: [tenantId, id], onDelete: Restrict)
  customer Customer?   @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  lines    OrderLine[]
  payments Payment[]

  @@unique([tenantId, id])
  @@unique([tenantId, storeId, number])
  @@index([tenantId, storeId, status, openedAt])
  @@index([tenantId, customerId, openedAt])
  @@map("order")
  @@schema("tala")
}

model OrderLine {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  orderId             String    @map("order_id") @db.Uuid
  variantId           String?   @map("variant_id") @db.Uuid
  // Snapshots taken when the line is added; later catalog edits never change history.
  itemName            String    @map("item_name")
  variantName         String?   @map("variant_name")
  unitPriceMinor      Int       @map("unit_price_minor")
  quantity            Int
  taxRateBps          Int       @default(0) @map("tax_rate_bps")
  modifiersTotalMinor Int       @default(0) @map("modifiers_total_minor")
  lineTotalMinor      Int       @map("line_total_minor")
  note                String?
  addedAt             DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  addedBy             String    @map("added_by")
  voidedAt            DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedBy            String?   @map("voided_by")
  voidReason          String?   @map("void_reason")

  order          Order               @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  variant        Variant?            @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  modifiers      OrderLineModifier[]
  stockMovements StockMovement[]

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@map("order_line")
  @@schema("tala")
}

model OrderLineModifier {
  id              String  @id @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  orderLineId     String  @map("order_line_id") @db.Uuid
  modifierId      String? @map("modifier_id") @db.Uuid
  groupName       String  @map("group_name")
  name            String
  priceDeltaMinor Int     @map("price_delta_minor")

  orderLine OrderLine @relation(fields: [tenantId, orderLineId], references: [tenantId, id], onDelete: Cascade)
  modifier  Modifier? @relation(fields: [tenantId, modifierId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, orderLineId])
  @@map("order_line_modifier")
  @@schema("tala")
}

// ───────────────────────────────── payments ─────────────────────────────────

enum PaymentMethod {
  CASH
  CARD
  CRYPTO

  @@map("payment_method")
  @@schema("tala")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELED

  @@map("payment_status")
  @@schema("tala")
}

model Payment {
  id            String        @id @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  terminalId    String?       @map("terminal_id") @db.Uuid
  method        PaymentMethod
  /// Adapter id, e.g. "stripe". Null for cash.
  provider      String?
  status        PaymentStatus @default(PENDING)
  amountMinor   Int           @map("amount_minor")
  tipMinor      Int           @default(0) @map("tip_minor")
  currency      String        @db.Char(3)
  /// Provider's id (e.g. PaymentIntent id).
  externalId    String?       @map("external_id")
  /// Crypto asset, e.g. "USDC".
  asset         String?
  failureReason String?       @map("failure_reason")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order    Order     @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  terminal Terminal? @relation(fields: [tenantId, terminalId], references: [tenantId, id], onDelete: Restrict)
  refunds  Refund[]

  @@unique([tenantId, id])
  @@unique([provider, externalId])
  @@index([tenantId, orderId])
  @@map("payment")
  @@schema("tala")
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED

  @@map("refund_status")
  @@schema("tala")
}

model Refund {
  id          String       @id @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  paymentId   String       @map("payment_id") @db.Uuid
  amountMinor Int          @map("amount_minor")
  currency    String       @db.Char(3)
  reason      String
  status      RefundStatus @default(PENDING)
  externalId  String?      @map("external_id")
  /// Optional: lines being refunded (for restock and reporting).
  lineIds     String[]     @default([]) @map("line_ids") @db.Uuid
  restock     Boolean      @default(false)
  actor       String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, paymentId])
  @@map("refund")
  @@schema("tala")
}

enum PaymentAccountStatus {
  PENDING
  ACTIVE
  RESTRICTED
  DISCONNECTED

  @@map("payment_account_status")
  @@schema("tala")
}

/// A tenant's account at a provider (e.g. a Stripe Connect connected account).
model PaymentAccount {
  id                String               @id @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  provider          String
  externalAccountId String               @map("external_account_id")
  status            PaymentAccountStatus @default(PENDING)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, provider])
  @@unique([provider, externalAccountId])
  @@map("payment_account")
  @@schema("tala")
}

/// Inbound provider webhook events; the unique key is the idempotency/dedupe point.
/// Not tenant-scoped at insert time (tenant is resolved while processing).
model ProviderEvent {
  id          String    @id @db.Uuid
  provider    String
  externalId  String    @map("external_id")
  tenantId    String?   @map("tenant_id") @db.Uuid
  type        String
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@unique([provider, externalId])
  @@index([processedAt])
  @@map("provider_event")
  @@schema("tala")
}

// ────────────────────────────── sync & review ───────────────────────────────

enum SyncMutationStatus {
  APPLIED
  DUPLICATE
  CONFLICT
  REJECTED

  @@map("sync_mutation_status")
  @@schema("tala")
}

model SyncMutation {
  /// Client-generated UUID; the dedupe key.
  id         String             @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  terminalId String             @map("terminal_id") @db.Uuid
  type       String
  payload    Json
  clientTs   DateTime           @map("client_ts") @db.Timestamptz(3)
  receivedAt DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  status     SyncMutationStatus
  result     Json?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  terminal    Terminal     @relation(fields: [tenantId, terminalId], references: [tenantId, id], onDelete: Restrict)
  reviewItems ReviewItem[]

  @@id([tenantId, id])
  @@index([tenantId, terminalId, receivedAt])
  @@map("sync_mutation")
  @@schema("tala")
}

enum ReviewKind {
  SYNC_CONFLICT
  NEGATIVE_STOCK
  PAYMENT_MISMATCH

  @@map("review_kind")
  @@schema("tala")
}

enum ReviewStatus {
  OPEN
  RESOLVED
  DISMISSED

  @@map("review_status")
  @@schema("tala")
}

model ReviewItem {
  id             String       @id @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  kind           ReviewKind
  subjectType    String       @map("subject_type")
  subjectId      String       @map("subject_id") @db.Uuid
  syncMutationId String?      @map("sync_mutation_id") @db.Uuid
  details        Json
  status         ReviewStatus @default(OPEN)
  resolution     Json?
  resolvedBy     String?      @map("resolved_by")
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  syncMutation SyncMutation? @relation(fields: [tenantId, syncMutationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("review_item")
  @@schema("tala")
}

/// Outbox for domain events (order.completed, refund.succeeded, …). Written in the same
/// transaction as the change and delivered through a Cloudflare Queue; `processed_at` is set
/// once hooks and receipts have succeeded.
model DomainEvent {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  orderId     String?   @map("order_id") @db.Uuid
  payload     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([processedAt, createdAt])
  @@map("domain_event")
  @@schema("tala")
}

/// Change feed for terminal pulls (catalog, prices, config).
///
/// Readers page by `(txid, seq)` and only read rows whose transaction id is below the oldest
/// running transaction (`pg_snapshot_xmin`). `seq` alone isn't safe as a cursor: a transaction can
/// take a lower `seq` and commit after a reader has already moved past it.
model ChangeLog {
  seq       BigInt              @id @default(autoincrement())
  tenantId  String              @map("tenant_id") @db.Uuid
  entity    String
  entityId  String              @map("entity_id") @db.Uuid
  /// For store-specific entities (store, store_item), so pulls can filter by store.
  storeId   String?             @map("store_id") @db.Uuid
  op        String
  txid      Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()"))
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, seq])
  @@map("change_log")
  @@schema("tala")
}
