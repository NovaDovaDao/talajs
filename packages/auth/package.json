{
  "name": "@talajs/auth",
  "version": "0.2.0",
  "description": "Optional built-in sign-in for Tala merchants and staff (magic link, password, Google), powered by Better Auth.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/NovaDovaDao/talajs/tree/main/packages/auth#readme",
  "bugs": {
    "url": "https://github.com/NovaDovaDao/talajs/issues"
  },
  "keywords": [
    "better-auth",
    "auth",
    "magic-link",
    "cloudflare-workers",
    "pos",
    "commerce"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaDovaDao/talajs.git",
    "directory": "packages/auth"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@talajs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@talajs/api": "workspace:*",
    "@talajs/contracts": "workspace:*",
    "@talajs/db": "workspace:*",
    "better-auth": "1.7.27"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.2",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/pg": "^8.23.1",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
